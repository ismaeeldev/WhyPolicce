# WhyPolice backend — environment template
# Copy to .env for local dev:  cp .env.example .env
# Production (Google Cloud Run): set each variable via `gcloud run deploy
# --set-env-vars` or Secret Manager — see DEPLOYMENT.md §2.

# --- Database ---
# Neon Postgres connection string (Neon dashboard -> Connection Details).
# Local testing without Neon: sqlite:///./test_local.db
DATABASE_URL=

# --- Auth0 (must match frontend/.env.example exactly) ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://whypolice-api

# --- Stripe (client sets at deploy — checkout returns 501 until configured) ---
# Secret key: Stripe Dashboard -> Developers -> API keys (test mode for staging)
STRIPE_SECRET_KEY=
# Pro plan price id: Stripe Dashboard -> Products -> Price ID
STRIPE_PRICE_ID=
# Webhook signing secret: Stripe Dashboard -> Webhooks -> endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=

# --- CORS & redirects ---
# Comma-separated allowed frontend origins. Production example:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://whypolice.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Frontend base URL — used for Stripe Checkout success/cancel redirects
FRONTEND_URL=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Server port ---
# Cloud Run injects PORT automatically (usually 8080) — do NOT set in production.
PORT=8000

# --- AI search (OpenAI primary, Gemini fallback on any OpenAI error) ---
# Both empty = honest mock/template response instead of crashing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
