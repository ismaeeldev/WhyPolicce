# WhyPolice backend — environment template
# Copy to .env for local dev:  cp .env.example .env
# Production (Google Cloud Run): set each variable via `gcloud run deploy
# --set-env-vars` or Secret Manager — see DEPLOYMENT.md §2.

# --- Database ---
# Neon Postgres connection string (Neon dashboard -> Connection Details).
# Local testing without Neon: sqlite:///./test_local.db
DATABASE_URL=

# --- Auth0 (must match frontend/.env.example exactly) ---
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://whypolice-api

# --- Stripe (client sets at deploy — checkout returns 501 until configured) ---
# Secret key: Stripe Dashboard -> Developers -> API keys (test mode for staging)
STRIPE_SECRET_KEY=
# Pro plan price id: Stripe Dashboard -> Products -> Price ID
STRIPE_PRICE_ID=
# Webhook signing secret: Stripe Dashboard -> Webhooks -> endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=

# --- GCS evidence uploads (Milestone 3 Step M3.1 — client sets up the
# bucket/service account; upload-url returns 501 until configured) ---
GCS_BUCKET_NAME=
# Path to a service account JSON key file. Never commit the file itself.
GCS_SERVICE_ACCOUNT_JSON_PATH=

# --- Forum billing, Milestone 3 Step M3.2 (a BRAND-NEW Stripe account —
# deliberately separate from STRIPE_SECRET_KEY/STRIPE_PRICE_ID above,
# which belong to the old product's single Pro-plan subscription) ---
FORUM_STRIPE_SECRET_KEY=
FORUM_STRIPE_WEBHOOK_SECRET=
# One-time $2.99 citizen inquiry-upgrade price id.
FORUM_STRIPE_INQUIRY_UPGRADE_PRICE_ID=
# Recurring $149/month attorney-subscription price id.
FORUM_STRIPE_ATTORNEY_SUBSCRIPTION_PRICE_ID=

# --- Email alerts, Milestone 3 Step M3.3 (developer's own choice of
# provider, per the Manual Step's instruction — Resend chosen). Sending
# is skipped with an honest log line until RESEND_API_KEY is set. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=WhyPolice <notifications@whypolice.com>

# --- CORS & redirects ---
# Comma-separated allowed frontend origins. Production example:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://whypolice.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Frontend base URL — used for Stripe Checkout success/cancel redirects
FRONTEND_URL=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Server port ---
# Cloud Run injects PORT automatically (usually 8080) — do NOT set in production.
PORT=8000

# --- AI search (OpenAI primary, Gemini fallback on any OpenAI error) ---
# Both empty = honest mock/template response instead of crashing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- RAG pipeline (public safety record retrieval) ---
# Uses OPENAI_API_KEY above — no separate key needed. Must stay
# text-embedding-3-small (1536 dims) unless app/models/public_record.py's
# Vector column dimension is migrated to match a different model's output.
EMBEDDING_MODEL=text-embedding-3-small

