# WhyPolice frontend — environment template
# Copy for local dev:  cp .env.example .env.local
# Production (Vercel or your host): add each variable in the dashboard.
# Backend deploys separately on Google Cloud Run — see DEPLOYMENT.md.

# --- Auth0 ---
# Dashboard -> Applications -> Applications (Regular Web Application)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a NEW value for production — do not reuse local dev secret.
AUTH0_SECRET=
# Dashboard -> Applications -> APIs -> your API -> Identifier
AUTH0_AUDIENCE=https://whypolice-api

# --- App URL ---
# Local: http://localhost:3000
# Production: https://your-app.vercel.app (or custom domain)
APP_BASE_URL=http://localhost:3000

# --- Stripe (publishable key only — safe for browser) ---
# Stripe Dashboard -> Developers -> API keys (test mode until go-live)
STRIPE_PUBLISHABLE_KEY=

# --- Backend API ---
# URL the *browser* reaches the backend at (never an internal Docker hostname).
# Local: http://localhost:8000
# Production: https://whypolice-backend-xxxx.a.run.app (your Cloud Run URL)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Auth0 app settings (configure in Auth0 Dashboard, not here) ---
# Allowed Callback URLs:   {APP_BASE_URL}/auth/callback
# Allowed Logout URLs:     {APP_BASE_URL}
# Allowed Web Origins:     {APP_BASE_URL}
# Authorize app for API:   Applications -> APIs -> your API -> Machine to Machine
